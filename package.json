{
  "name": "@yunyoujun/ak-ui",
  "version": "0.2.1",
  "description": "Framework-agnostic Arknights-inspired CSS interface modules.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "dev": "pnpm docs:dev",
    "lint": "stylelint \"src/scss/**/*.scss\"",
    "lint:fix": "pnpm lint --fix",
    "registry:build": "shadcn-vue build --output docs/public/r",
    "registry:verify": "node scripts/verify-registry.mjs",
    "docs:dev": "pnpm registry:build && vitepress dev docs --host 0.0.0.0",
    "docs:build": "pnpm build && pnpm registry:build && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:linux": "sh scripts/run-visual-linux.sh test",
    "test:visual:update:linux": "sh scripts/run-visual-linux.sh update",
    "test": "pnpm lint && pnpm docs:build && pnpm registry:verify && pnpm test:visual:linux",
    "prepublishOnly": "pnpm build"
  },
  "style": "dist/ak-ui.min.css",
  "sass": "src/scss/ak-ui.scss",
  "main": "dist/ak-ui.min.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/ak-ui.git"
  },
  "keywords": [
    "ak-ui",
    "arknights",
    "framework",
    "web"
  ],
  "author": "YunYouJun",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/ak-ui/issues"
  },
  "homepage": "https://ak-ui.yyj.moe",
  "exports": {
    ".": {
      "sass": "./src/scss/ak-ui.scss",
      "style": "./dist/ak-ui.css",
      "default": "./dist/ak-ui.css"
    },
    "./style.css": "./dist/ak-ui.css",
    "./style.min.css": "./dist/ak-ui.min.css",
    "./scss": "./src/scss/ak-ui.scss",
    "./depth": {
      "types": "./src/js/dashboard-depth.d.ts",
      "import": "./src/js/dashboard-depth.mjs",
      "default": "./src/js/dashboard-depth.mjs"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "lint-staged": {
    "src/scss/**/*.scss": "pnpm lint"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "autoprefixer": "^10.5.4",
    "clean-css": "^5.3.3",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "markdown-it-container": "^4.0.0",
    "postcss": "^8.5.25",
    "sass": "^1.102.0",
    "shadcn-vue": "2.8.1",
    "stylelint": "^14.16.1",
    "stylelint-config-recommended-scss": "^8.0.0",
    "stylelint-scss": "^4.7.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.40"
  },
  "files": [
    "dist",
    "src/js",
    "src/scss"
  ]
}
