{
  "name": "@yunyoujun/ak-ui",
  "version": "0.2.1",
  "type": "module",
  "description": "Arknights-inspired design language, tokens, and framework-agnostic CSS primitives.",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "dev": "pnpm docs:dev",
    "audit:deps": "pnpm audit --audit-level low",
    "lint": "stylelint \"src/scss/**/*.scss\"",
    "lint:fix": "pnpm lint --fix",
    "tokens:verify": "node scripts/verify-tokens.mjs",
    "registry:build": "shadcn-vue build --output docs/public/r",
    "registry:verify": "node scripts/verify-registry.mjs",
    "docs:dev": "pnpm registry:build && vitepress dev docs --host 0.0.0.0",
    "docs:build": "pnpm build && pnpm registry:build && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:linux": "sh scripts/run-visual-linux.sh test",
    "test:visual:update:linux": "sh scripts/run-visual-linux.sh update",
    "test": "pnpm audit:deps && pnpm lint && pnpm docs:build && pnpm tokens:verify && pnpm registry:verify && pnpm test:visual:linux",
    "release:github": "changelogithub",
    "release:notes": "changelogithub --dry",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "style": "dist/ak-ui.min.css",
  "sass": "src/scss/ak-ui.scss",
  "main": "dist/ak-ui.min.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/ak-ui.git"
  },
  "keywords": [
    "ak-ui",
    "arknights",
    "design-tokens",
    "agent-skills",
    "framework",
    "web"
  ],
  "author": "YunYouJun",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/ak-ui/issues"
  },
  "homepage": "https://ak-ui.yyj.moe",
  "exports": {
    ".": {
      "sass": "./src/scss/ak-ui.scss",
      "style": "./dist/ak-ui.css",
      "default": "./dist/ak-ui.css"
    },
    "./style.css": "./dist/ak-ui.css",
    "./style.min.css": "./dist/ak-ui.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.min.css": "./dist/tokens.min.css",
    "./scss": "./src/scss/ak-ui.scss",
    "./depth": {
      "types": "./src/js/dashboard-depth.d.ts",
      "import": "./src/js/dashboard-depth.mjs",
      "default": "./src/js/dashboard-depth.mjs"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "lint-staged": {
    "src/scss/**/*.scss": "pnpm lint"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "autoprefixer": "^10.5.4",
    "changelogithub": "15.0.4",
    "clean-css": "^5.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdown-it-container": "^4.0.0",
    "postcss": "^8.5.26",
    "sass": "^1.102.0",
    "shadcn-vue": "2.8.2",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.2.0",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.41"
  },
  "files": [
    "dist",
    "src/js",
    "src/scss"
  ]
}
